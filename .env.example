# PostgreSQL (Docker Compose usa estos valores por defecto)
POSTGRES_USER=buzon
POSTGRES_PASSWORD=buzon_secret
POSTGRES_DB=buzon_utmach

# Conexión de Prisma a la base de datos
DATABASE_URL="postgresql://buzon:buzon_secret@localhost:5432/buzon_utmach?schema=public"

# Auth.js (NextAuth v5)
# Genera un secreto con: openssl rand -base64 32
AUTH_SECRET="cambia-este-secreto-por-uno-seguro"
AUTH_URL="http://localhost:3000"

# Credenciales del administrador del dashboard.
# En PRODUCCIÓN usa ADMIN_PASSWORD_HASH (hash bcrypt), no la clave en texto plano.
#   Genera el hash con:  node -e "console.log(require('bcryptjs').hashSync('TU_CLAVE',10))"
ADMIN_EMAIL="cambia-este-correo@example.com"
ADMIN_PASSWORD_HASH="$2a$10$reemplaza-por-tu-hash-bcrypt"
# ADMIN_PASSWORD solo como respaldo para desarrollo local (si no defines el hash):
# ADMIN_PASSWORD="define-una-contrasena-segura"

# Secreto para seudonimizar los identificadores antiabuso (IP/dispositivo).
# Genera uno con: openssl rand -hex 32
GUARD_SECRET="cambia-esto-por-un-secreto-largo"

# Cloudflare Turnstile (verificación antibot del formulario público).
# Las TRES variables van juntas: si falta alguna, los envíos se RECHAZAN
# (fallo cerrado) en vez de quedar desprotegidos en silencio.
# Si no defines ninguna, Turnstile queda apagado (útil en local).
#
# TURNSTILE_SITE_KEY es pública y se lee en el servidor a propósito: usar
# NEXT_PUBLIC_* la incrustaría al compilar la imagen Docker, y aquí la
# configuración vive en Azure, no en el build.
# Van las TRES comentadas a propósito: definir solo algunas es justo el estado
# "misconfigured" y el formulario rechazaría todos los envíos. Descoméntalas
# juntas cuando quieras probar Turnstile en local.
# TURNSTILE_SITE_KEY="1x00000000000000000000AA"
# TURNSTILE_SECRET="1x0000000000000000000000000000000AA"
# Hostnames del frontend aceptados, separados por comas.
# En PRODUCCIÓN no incluyas nunca localhost ni 127.0.0.1.
# TURNSTILE_HOSTNAMES="localhost,127.0.0.1"
